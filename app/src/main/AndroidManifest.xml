<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      v4 起不再需要任何存储权限：
      微信侧的日志通过 ContentProvider 走 Binder 送进模块 App 的私有目录。
    -->

    <application
        android:allowBackup="true"
        android:label="WechatLive"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!-- 真正的入口 Activity：自身带 LAUNCHER，始终显示在桌面（不再提供隐藏能力） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WechatLive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          状态通道：微信进程内的 Hook 通过它回报心跳/日志，并取回用户设置的开关。
          必须 exported，因为调用方（微信）是另一个 App。
        -->
        <provider
            android:name=".StatusProvider"
            android:authorities="com.abel.wechatlive.status"
            android:enabled="true"
            android:exported="true" />

        <!-- 导出日志专用：把外部私有目录里的日志文件以 content:// 暴露给其它 App 读取。
             exported=false + grantUriPermissions=true：仅本次分享授权的 App 能读，安全。 -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.abel.wechatlive.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          ===== LibXposed 模块声明（v8.7 起，替代旧的 xposedmodule meta-data）=====
          模块元数据/作用域/入口统一走 META-INF/xposed/（见 src/main/resources/META-INF/xposed/）：
            - module.prop    模块配置（minApiVersion/targetApiVersion）
            - java_init.list 模块入口类（com.abel.wechatlive.MainHook）
            - scope.list     作用域（com.tencent.mm）
          旧式 xposedmodule / xposedminversion / xposeddescription / xposedscope
          meta-data 已在 v8.7 移除。
        -->

    </application>

</manifest>
