<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      v4 起不再需要任何存储权限：
      微信侧的日志通过 ContentProvider 走 Binder 送进模块 App 的私有目录。
    -->

    <application
        android:allowBackup="true"
        android:label="WechatLive"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!-- 真正的入口 Activity：不带 LAUNCHER 过滤器，靠下面的 alias 进桌面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WechatLive" />

        <!-- 桌面启动入口（可隐藏）。隐藏图标 = 禁用这个 alias，Activity 本体不受影响 -->
        <activity-alias
            android:name=".LauncherEntry"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="WechatLive"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          状态通道：微信进程内的 Hook 通过它回报心跳/日志，并取回用户设置的开关。
          必须 exported，因为调用方（微信）是另一个 App。
        -->
        <provider
            android:name=".StatusProvider"
            android:authorities="com.abel.wechatlive.status"
            android:enabled="true"
            android:exported="true" />

        <!-- 导出日志专用：把外部私有目录里的日志文件以 content:// 暴露给其它 App 读取。
             exported=false + grantUriPermissions=true：仅本次分享授权的 App 能读，安全。 -->
        <provider
            android:name=".LogFileProvider"
            android:authorities="com.abel.wechatlive.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 隐藏桌面图标后的找回入口：拨号盘输入 *#*#7356#*#* -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7356" />
            </intent-filter>
        </receiver>

        <!-- ===== LSPosed / Xposed 模块声明 ===== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposeddescription"
            android:value="微信发图自动实况(LivePhoto)+原图，可在应用内开关" />
        <!-- 静态作用域：只声明微信。LSPosed 的作用域列表会过滤模块自身，勾不上是正常的 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
